---
import '../styles/global.css';import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';
const {t,title=t.title,description=t.description}=Astro.props;
const canonical=new URL(Astro.url.pathname,'https://patchsre.com');
const is404=Astro.url.pathname.includes('404');
const esPath=Astro.url.pathname.replace(/^\/en\//,'/');
---
<!doctype html><html lang={t.lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; base-uri 'self'; form-action 'self' https://api.patchsre.com mailto:"/><meta name="referrer" content="strict-origin-when-cross-origin"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{is404&&<meta name="robots" content="noindex"/>}{!is404&&<><link rel="alternate" hreflang="es" href={`https://patchsre.com${esPath}`}/><link rel="alternate" hreflang="en" href={`https://patchsre.com/en${esPath}`}/></>}<link rel="icon" href="/logo-patch.svg" type="image/svg+xml"/><link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin/><meta property="og:type" content="website"/><meta property="og:site_name" content="Patch by NimboxSRE"/><meta property="og:locale" content={t.locale}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://patchsre.com/og.png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Patch by NimboxSRE · Tus agentes parchean. Tú firmas."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content="https://patchsre.com/og.png"/><slot name="head"/></head><body><Header t={t}/><main id="contenido"><slot/></main><Footer t={t}/><script src="../scripts/main.ts"></script></body></html>
