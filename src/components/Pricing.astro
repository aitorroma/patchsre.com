---
import {config} from '../data/config';import {fill,money} from '../data/utils';const {t}=Astro.props;const p=t.pricing;const l=config.limits;
---
<section id="precios" class="section container reveal"><div class="section-heading"><span class="section-tag">{p.tag}</span><h2>{p.title}</h2><p>{p.subtitle}</p></div><div class="pricing-grid"><article class="card price-card"><h3>{p.free}</h3><p>{p.freeDescription}</p><div class="price">{money(0,t.lang)}</div><ul class="feature-list">{p.freeFeatures.map((s:string)=><li>✓ {fill(s)}</li>)}</ul><a class="button secondary" href={config.freeAccess}>{p.freeCta}</a></article><article class="card price-card featured"><span class="recommended">{p.recommended}</span><h3>MSP</h3><p>{p.mspDescription}</p><div class="price">{money(config.prices.msp,t.lang)}<small>{p.unit}</small></div><ul class="feature-list">{p.mspFeatures.map((s:string)=><li>✓ {s}</li>)}</ul><p class="minimum">{fill(p.minimum)}</p><form method="POST" action={config.checkout} data-configurator data-rate={config.prices.msp} data-lang={t.lang}><label for="hosts">{p.hosts}</label><div class="host-controls"><input type="range" id="hosts-range" min={l.minHosts} max={l.sliderMax} value={l.defaultHosts} step="1" aria-label={p.hosts}/><input id="hosts" name="hosts" type="number" min={l.minHosts} value={l.defaultHosts} required step="1"/></div><label for="clients">{p.clients}</label><input id="clients" name="clients" type="number" min="1" value={l.includedClients} required step="1"/><small>{fill(p.included)}</small><label class="checkbox"><input type="checkbox" name="whitelabel" id="whitelabel" value="1"/>{p.white}</label><label class="checkbox"><input type="checkbox" name="domain" id="domain" value="1"/>{p.domain}</label><label for="company">{p.company}</label><input id="company" name="company" autocomplete="organization"/><label for="email">{p.email}</label><input id="email" name="email" type="email" autocomplete="email"/><div class="estimate"><span>{p.estimate}</span><output id="total" aria-live="polite">{money(l.defaultHosts*config.prices.msp,t.lang)}</output><small data-extras hidden>{p.quote}</small></div><small>{p.confirm}</small><button type="submit" class="button primary">{p.submit}</button><noscript><p>{p.nojs}</p></noscript></form></article><article class="card price-card"><h3>MSP Pro</h3><p>{p.proDescription}</p><div class="price">{money(config.prices.pro,t.lang)}<small>{p.unit}</small></div><ul class="feature-list">{p.proFeatures.map((s:string)=><li>✓ {fill(s)}</li>)}</ul><a class="button secondary" href={config.demo}>{p.talk}</a></article></div><div class="extras"><strong>{p.extras}</strong><a href={config.contact}>{p.consult} →</a></div><p class="payment-note">{p.payment}</p></section>
