---
const {t}=Astro.props;const root=t.lang==='en'?'/en/':'/';const paths=['aviso-legal','privacidad','cookies'];
---
<footer class="container footer"><div><a class="brand" href={root}><img src="/logo-patch.svg" width="32" height="32" alt=""/><strong>Patch <small>by NimboxSRE</small></strong></a><p>{t.footer}</p></div><div class="footer-links"><a href="mailto:hola@patchsre.com">hola@patchsre.com</a>{t.legal.names.map((name:string,i:number)=><a href={`${root}${paths[i]}/`}>{name}</a>)}<a href="https://nimboxsre.com">NimboxSRE</a></div></footer>
