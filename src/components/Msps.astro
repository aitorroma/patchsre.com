---
import {config} from '../data/config';const {t}=Astro.props;const f=config.figures;
---
<section id="msps" class="section container reveal"><div class="section-heading"><span class="section-tag">{t.msp.tag}</span><h2>{t.msp.title}</h2><p>{t.msp.subtitle}</p></div><div class="split msp-split"><div class="feature-stack">{t.msp.items.map((item:string[])=><article><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div><div class="product-mockups"><article class="card dashboard"><div class="dashboard-head"><h3>{t.msp.center}</h3><span class="pill green">✓ {t.chat.verified}</span></div><div class="posture"><strong>{f.posture}<small>/100</small></strong><span>{t.msp.posture}</span></div><div class="mini-metrics">{[f.patched,f.patched,f.discarded,0,0].map((n,i)=><div><strong>{n}</strong><span>{t.msp.metrics[i]}</span></div>)}</div><h4>{t.msp.vulnerabilities}</h4><ul class="vulnerability-list"><li><span class="severity critical">{t.msp.critical}</span><code>{f.cve}</code><span>web-01</span></li><li><span class="severity high">{t.msp.high}</span><span>db-prod</span><small>{t.msp.unaffected}</small></li></ul><small>{t.msp.example}</small></article><article class="card report"><div class="report-brand"><span aria-hidden="true">A/</span>{t.msp.reportBrand}</div><h3>{t.msp.report}</h3><strong>{t.msp.client}</strong><p>{t.msp.reportBody}</p><div class="report-bars"><i></i><i></i><i></i></div><small>{t.msp.example}</small></article></div></div><div class="distributions"><h3>{t.msp.distros}</h3><div>{config.distributions.map(name=><span>{name}</span>)}</div></div></section>
