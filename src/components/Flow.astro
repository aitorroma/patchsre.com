---
import Icon from './Icon.astro';const {t}=Astro.props;const icons=['alert','network','database','file','pen','gear','check','chart'];
---
<section class="container flow section reveal"><div class="flow-strip">{t.flow.names.map((name:string,i:number)=><a href={`#step-${i}`} class:list={[{'sign':i===4}]}><Icon name={icons[i]} size={32}/><span>{name}</span></a>)}</div><p class="agent-key">{t.agents.key}</p><details class="tool-details"><summary>{t.agents.toolsTitle}</summary><div class="tool-grid">{t.agents.tools.map((tool:string[])=><div><code>{tool[0]}</code><p>{tool[1]}</p></div>)}</div></details><div class="section-heading"><span class="section-tag">{t.flow.tag}</span><h2>{t.flow.title}</h2></div><ol class="flow-details">{t.flow.details.map((detail:string,i:number)=><li id={`step-${i}`}><span class="step-number">0{i+1}</span><h3>{t.flow.names[i]}</h3><p>{detail}</p></li>)}</ol></section>
