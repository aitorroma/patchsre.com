---
import {config} from '../data/config';import {fill} from '../data/utils';import Icon from './Icon.astro';import ChatLines from './ChatLines.astro';
const {t}=Astro.props;const f=config.figures;
---
<section class="hero" aria-labelledby="hero-title"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow">{t.hero.badge}</span><!-- Alternativas: «Tu flota al día. Tu firma al mando.» / «La IA prepara el parche. Tú mantienes el control.» --><h1 id="hero-title">{t.hero.first}<br/><span class="signature">{t.hero.second}</span></h1><p class="desktop-copy">{t.hero.body}</p><p class="mobile-copy">{t.hero.mobile}</p><div class="hero-actions"><a class="button primary" href={config.signup}>{t.start}</a><a class="button secondary" href={config.demo}>{t.demo}</a></div><small class="hero-note">{fill(t.hero.note)}</small></div><div class="terminal conversation desktop-conversation" role="region" aria-label={t.chat.label}><div class="terminal-bar"><i></i><i></i><i></i></div><ChatLines t={t}/><small class="chat-caption">{t.chat.approval}</small></div><div class="terminal conversation mobile-conversation" role="region" aria-label={t.chat.label}><div class="terminal-bar"><i></i><i></i><i></i></div><div class="conversation-lines"><div class="chat-line"><Icon name="alert"/><div>{f.cve} · {f.patched} {t.of} {f.affected} {t.chat.exposed}</div><time>03:12</time></div><div class="chat-line"><Icon name="check"/><div>✓ {f.patched} {t.chat.verifiedPlural} <span class="pill green">{t.chat.verified}</span></div><time>06:00</time></div></div><details class="mobile-activity"><summary>{t.chat.activity}</summary><ChatLines t={t}/><small class="chat-caption">{t.chat.approval}</small></details></div></div></section>
