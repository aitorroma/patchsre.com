---
import Icon from './Icon.astro';import {command} from '../data/config';import {fill} from '../data/utils';const {t}=Astro.props;
---
<section id="agentes" class="section agents container reveal"><div class="section-heading"><span class="section-tag">{t.agents.tag}</span><h2>{t.agents.title.split(t.agents.emphasis)[0]}<span class="signature">{t.agents.emphasis}</span>{t.agents.title.split(t.agents.emphasis)[1]}</h2><p>{t.agents.subtitle}</p></div><div class="permissions">{t.agents.cards.map((card:string[],i:number)=><article class:list={['card',{'approved':i===2}]}><div class="card-top"><Icon name={['eye','file','shield'][i]} size={36}/>{i===2&&<span class="approval">{t.agents.approval}</span>}</div><h3>{card[0]}</h3><p>{card[1]}</p></article>)}</div><div class="agent-panels"><div><h3 class="small-heading">{t.agents.connect}</h3><div class="terminal code-terminal"><div class="terminal-bar"><i></i><i></i><i></i></div><pre><code id="mcp-command">{command}</code></pre><button class="copy button secondary" data-copy data-label={t.agents.copy} data-success={t.agents.copied} data-error={t.agents.copyError}>{t.agents.copy}</button><span class="copy-status sr-only" role="status"></span></div></div><details open class="card verification"><summary><strong>{t.agents.verification}</strong><span class="pill green">✓ {t.chat.verified}</span></summary><ul>{t.agents.checks.map((s:string)=><li><Icon name="check"/>{fill(s)}</li>)}</ul></details></div></section>
