---
import {config} from '../data/config';
const {t}=Astro.props;
const ids=['producto','agentes','seguridad','msps','precios','faq'];
const root=t.lang==='en'?'/en/':'/';
const currentPath=Astro.url.pathname.replace(/^\/en(?=\/|$)/,'') || '/';
const languagePaths={es:currentPath,en:`/en${currentPath}`};
---
<a class="skip" href="#contenido">{t.skip}</a>
<header class="header">
  <div class="nav-wrap">
    <a href={root} class="brand" aria-label="Patch by NimboxSRE">
      <img src="/logo-patch.svg" width="42" height="42" alt=""/>
      <span><strong>Patch</strong><small>by NimboxSRE</small></span>
    </a>
    <button class="menu-toggle" aria-label={t.menu} aria-controls="navigation" aria-expanded="false"><span></span><span></span><span></span></button>
    <nav id="navigation" aria-label={t.lang==='es'?'Navegación principal':'Main navigation'}>
      {t.nav.map((label:string,i:number)=><a href={`${root}#${ids[i]}`}>{label}</a>)}
      <div class="header-actions">
        <div class="language-picker" role="group" aria-label={t.lang==='es'?'Idioma':'Language'}>
          <svg class="language-globe" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg>
          <div class="language-switch">
            <a href={languagePaths.es} lang="es" hreflang="es" aria-label="Español (ES)" aria-current={t.lang==='es'?'page':undefined}>ES</a>
            <a href={languagePaths.en} lang="en" hreflang="en" aria-label="English (EN)" aria-current={t.lang==='en'?'page':undefined}>EN</a>
          </div>
        </div>
        <a href={config.login} class="login">{t.login}</a>
        <a class="button primary nav-cta" href={config.signup}>{t.start}</a>
      </div>
    </nav>
  </div>
</header>
